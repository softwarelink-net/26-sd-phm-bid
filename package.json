{
  "name": "26-sd-phm-bid",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "山东第一医科大学附属消化病医院公共卫生管理信息平台系统购置项目原型演示",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "preview:worker": "npm run build && wrangler dev",
    "db:migrate": "wrangler d1 execute Allworld --local --file=./worker/schema.sql",
    "db:seed": "wrangler d1 execute Allworld --local --file=./worker/schema.sql",
    "db:migrate:remote": "wrangler d1 execute Allworld --remote --file=./worker/schema.sql",
    "deploy": "npm run build && wrangler deploy && node scripts/deploy-allworld.mjs 26-sd-phm-bid",
    "deploy:r2": "node scripts/deploy-allworld.mjs 26-sd-phm-bid",
    "deploy:worker": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "lucide-vue-next": "^0.511.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.0",
    "wrangler": "^4.123.0"
  }
}
